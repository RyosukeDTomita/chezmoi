{
  "env": {
    "EDITOR": "nvim",
    "VISITOR": "nvim"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Read",
      "Grep",
      "Glob",
      "Bash(tree:*)",
      "Bash(chezmoi managed *)"
    ],
    "deny": [
      "Read(**/sigma.md)",
      "Edit(**/sigma.md)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "FLAG=/tmp/claude_notified; [ -f \"$FLAG\" ] || { play /usr/share/sounds/freedesktop/stereo/window-attention.oga 2>/dev/null; touch \"$FLAG\"; }"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "play /usr/share/sounds/freedesktop/stereo/message-new-instant.oga 2>/dev/null"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f /tmp/claude_notified"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/sigma/.claude/skills/daily-brief/hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/sigma/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "eli5@claude-community": true,
    "i-have-adhd@i-have-adhd": true,
    "explainer@explainer": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "explainer": {
      "source": {
        "source": "github",
        "repo": "mizchi/explainer"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
